@{
    ViewData["NonSixOs"] = true;
}
<style>
    table {
        border-right: 1px solid #ccc !important;
        border-left: 1px solid #ccc !important;
    }

    .table-wrapper-scroll th,
    .table-wrapper-scroll td {
        white-space: nowrap;
    }

    .table-wrapper-scroll thead th:nth-child(1) {
        position: sticky;
        top: 0;
        left: 0;
        z-index: 25;
        background-color: #f2f2f2;
        border-right: 1px solid #ccc !important;
        width: 40px;
    }

    .table-wrapper-scroll thead th:nth-child(2) {
        position: sticky;
        top: 0;
        left: 40px;
        z-index: 25;
        background-color: #f2f2f2;
        border-right: 1px solid #ccc !important;
        width: 102px;
    }

    .table-wrapper-scroll thead th:nth-child(3) {
        position: sticky;
        top: 0;
        left: 102px;
        z-index: 25;
        background-color: #f2f2f2;
        border-right: 1px solid #ccc !important;
    }

    .table-wrapper-scroll tbody tr td:nth-child(1) {
        position: sticky;
        left: 0;
        z-index: 1;
        background-color: white;
        border-right: 1px solid #ccc !important;
        width: 40px;
    }

    .table-wrapper-scroll tbody tr td:nth-child(2):not(.khongapdung) {
        position: sticky;
        left: 40px;
        z-index: 1;
        background-color: white;
        border-right: 1px solid #ccc !important;
        width: 102px;
    }

    .table-wrapper-scroll tbody tr td:nth-child(3):not(.khongapdung) {
        position: sticky;
        left: 102px;
        z-index: 1;
        background-color: white;
        border-right: 1px solid #ccc !important;
    }

    .table-wrapper-scroll tbody tr:hover td {
        background-color: #bae7ff !important;
    }

    .table-wrapper-scroll tbody tr.total-row td {
        background-color: #f0f0f0;
        font-weight: bold;
    }

    .table-wrapper-scroll tr.selected td {
        background-color: #bae7ff !important;
    }
</style> 
@section Styles{
    <link rel="stylesheet" href="@Url.Content("~/dist/css/C0304/C0304_Report.css")" />
}
    <div class="card p-1">
        <div class="container_Team3">
            <div class="container_Team3 left">
                <div class="row" style="padding:0; margin: 5px;">
                    <div style="width: 100%; padding:0;">
                        <label class="form-label">Giai đoạn</label>
                        <select id="selectGiaiDoan" class="form-select">
                            <option value="Nam">Năm</option>
                            <option value="Quy">Quý</option>
                            <option value="Thang">Tháng</option>
                            <option value="Ngay" selected>Ngày</option>
                        </select>
                    </div>
                </div>

                <div class ="select-row" id="selectContainer"
                     style="margin: 5px; display: flex; padding:0;justify-content: flex-start; align-items: flex-start; flex-wrap: wrap;">
                </div>

                <div class="row" style="padding:0; margin: 5px;">
                    <div style="width: 100%;padding:0;">
                        <label class="form-label">Từ ngày</label>
                        <div class="input-group" id="ngayTuNgay-datepicker">
                            <input type="text"
                                   class="form-control date-input"
                                   id="ngayTuNgay"
                                   name="TuNgay"
                                   value='@DateTime.Now.ToString("dd-MM-yyyy")'
                                   placeholder="dd-mm-yyyy"
                                   autocomplete="off" />
                            <span class="input-group-text cursor-pointer datepicker-trigger" id="ngayTuNgay-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6c757d">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </span>
                        </div>
                        <span class="text-danger"></span>
                    </div>

                    <div style="width: 100%; margin: 5px 0px;padding:0;">
                        <label class="form-label">Đến ngày</label>
                        <div class="input-group" id="ngayDenNgay-datepicker">
                            <input type="text"
                                   class="form-control date-input"
                                   id="ngayDenNgay"
                                   name="DenNgay"
                                   value='@DateTime.Now.ToString("dd-MM-yyyy")'
                                   placeholder="dd-mm-yyyy"
                                   autocomplete="off" />
                            <span class="input-group-text cursor-pointer datepicker-trigger" id="ngayDenNgay-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6c757d">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </span>
                        </div>
                        <span class="text-danger"></span>
                    </div>

                    <div style="width: 100%;padding:0; margin: 5px 0px;" class="mb-1">
                        <label for="KhoHang" class="form-label">Kho hàng</label>
                        <select class="form-select tomselect-khoHang" name="tenKhoHang"></select>
                    </div>

                    <!--Nhóm hàng-->
                    <div style="width: 100%;padding:0; margin: 5px 0px;" class="mb-1">
                        <label for="NhomHang" class="form-label">Nhóm hàng</label>
                        <select class="form-select tomselect-nhomHang" name="tenNhomHang"></select>
                    </div>

                    <div style="width: 100%;padding:0; margin: 5px 0px;" class="mb-1">
                        <label for="HangHoa" class="form-label">Hàng hóa</label>
                        <select class="form-select tomselect-hangHoa" name="tenHangHoa"></select>
                    </div>

                    <label style="padding:0; margin:0px;">
                        <button id="btnFilter" class="btn btn-outline-primary mb-3">
                            <i class="bi bi-funnel"></i> Lọc danh sách
                        </button>
                    </label>

                </div>
                <div style="padding:0; margin: 5px;" class="row export-buttons">
                    @* <button id="btnExportPDF" class="btn btn-outline-danger mb-3" @((ViewBag.quyenVaiTro != null && ViewBag.quyenVaiTro.Xuat) ? "" : "disabled")>
                        <i class="bi bi-file-earmark-pdf"></i> Xuất PDF
                    </button> *@

                    <button id="btnExportExcel" class="btn btn-outline-success mb-3" @((ViewBag.quyenVaiTro != null && ViewBag.quyenVaiTro.Xuat) ? "" : "disabled")>
                        <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                    </button>
                </div>
            </div>

            <div class="container_Team3 right">
                <!-- Thêm spinner -->
                <div id="loadingSpinner" class="text-center" style="display: none; margin: 20px 0;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Đang tải dữ liệu...</p>
                </div>

                <div class="table-wrapper-scroll">
                    <table style="margin: auto;" cellpadding="8">
                        <thead>
                            <tr>
                                <th class="text-center text-nowrap">STT</th>
                                <th class="text-center text-nowrap">Mã y tế</th>
                                <th class="text-center text-nowrap">Tên bệnh nhân</th>
                                <th class="text-center text-nowrap">Năm sinh</th>
                                <th class="text-center text-nowrap">Giới tính</th>
                                <th class="text-center text-nowrap">Đối tượng</th>
                                <th class="text-center text-nowrap">Số lưu trữ</th>
                                <th class="text-center text-nowrap">Số bệnh án</th>
                                <th class="text-center text-nowrap">Khoa điều trị</th>
                                <th class="text-center text-nowrap">Ngày khám</th>
                                <th class="text-center text-nowrap">Tên phòng khám</th>
                                <th class="text-center text-nowrap">Bác sĩ kê toa</th>
                                <th class="text-center text-nowrap">Tên dược đầy đủ</th>
                                <th class="text-center text-nowrap">Tên hoạt chất</th>
                                <th class="text-center text-nowrap">Số ngày</th>
                                <th class="text-center text-nowrap">Số lượng</th>
                                <th class="text-center text-nowrap">Số lượng phát</th>
                                <th class="text-center text-nowrap">Đơn giá</th>
                                <th class="text-center text-nowrap">Chẩn đoán</th>
                                <th class="text-center text-nowrap">Mục đích xuất</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="phan_trang">
                    <div class="d-flex">
                        <label class="form-label" style="font-size:1rem !important;">Số bản ghi mỗi trang:</label>
                        <select id="pageSizeSelect" style="font-size:1rem !important;" class="form-select">
                            <option value="10">10</option>
                            <option value="20" selected>20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <div style="display:flex; align-items:center; ">
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center" id="pagination">
                            </ul>
                        </nav>
                        <div class="text-center" style="margin-left: 2px">
                            <span id="pageInfo"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @section Scripts {
    <script src="~/dist/libs/bootstrap-datepicker/js/bootstrap-datepicker.min.js" defer></script>
    <script src="~/dist/libs/bootstrap-datepicker/locales/bootstrap-datepicker.vi.min.js" defer></script>
    <script src="/dist/libs/tom-select/dist/js/tom-select.base.js" defer asp-append-version="true"></script>
    <script src="~/dist/libs/toast/toastr.min.js" defer></script>
    <script src="@Url.Content("~/dist/js/BienChung.js")" defer asp-append-version="true"></script>
    <script src="@Url.Content("~/dist/js/J0304Util/J0302DateFormatUtil.js")" defer asp-append-version="true"></script>
    <script src="~/dist/js/site.js" asp-append-version="true"></script>
    <script src="@Url.Content("~/dist/js/J0304/J0304BaoCaoCongTacKeDon.js")" defer asp-append-version="true"></script>
    <script src="@Url.Content("~/dist/js/J0304Util/J0302DateFormatUtil.js")" defer asp-append-version="true"></script>
    }
