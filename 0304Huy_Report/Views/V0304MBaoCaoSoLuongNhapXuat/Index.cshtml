@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/dist/css/C0304M/C0304M.css")" />
}
    <div class="card p-1">
        <div class="container_Team3">
            <div class="container_Team3 left">
                <div class="row g-3 align-items-end filter-row">
                    <div class="col-md-2">
                        <label for="nam" class="form-label">Chọn năm</label>
                        <select class="form-select tomselect-nam" name="tenNam"></select>
                    </div>
                    <!--Nhóm hàng-->
                    <div class="col-md-2">
                        <label for="NhomHang" class="form-label">Nhóm hàng</label>
                        <select class="form-select tomselect-nhomHang" name="tenNhomHang"></select>
                    </div>

                    <!--Hàng hóa-->
                    <div class="col-md-2">
                        <label for="HangHoa" class="form-label">Hàng hóa</label>
                        <select class="form-select tomselect-hangHoa" name="tenHangHoa"></select>
                    </div>

                    <div class="col-md-3 d-flex align-items-center gap-2 justify-content-center">
                        <!-- Radio nhóm Nhập/Xuất -->
                        <div class="d-flex gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="filterType" id="filterNhap" value="Nhap" checked>
                                <label class="form-check-label" for="filterNhap">Nhập</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="filterType" id="filterXuat" value="Xuat">
                                <label class="form-check-label" for="filterXuat">Xuất</label>
                            </div>
                        </div>

                        <!-- Nút Load -->
                        <button id="btnFilter" class="btn btn-outline-primary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <!--Nút export-->
                    <div class="col-md-3 d-flex gap-2">
                        <button id="btnExportPDF" class="btn btn-outline-danger flex-fill"
                                @((ViewBag.quyenVaiTro != null && ViewBag.quyenVaiTro.Xuat) ? "" : "disabled")>
                            <i class="bi bi-file-earmark-pdf"></i> PDF
                        </button>
                        <button id="btnExportExcel" class="btn btn-outline-success flex-fill"
                                @((ViewBag.quyenVaiTro != null && ViewBag.quyenVaiTro.Xuat) ? "" : "disabled")>
                            <i class="bi bi-file-earmark-excel"></i> Excel
                        </button>
                    </div>
                </div>
            </div>

            <div class="container_Team3 right">
                <!-- Thêm spinner -->
                <div id="loadingSpinner" class="text-center" style="display: none; margin: 20px 0;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Đang tải dữ liệu...</p>
                </div>

                <div class="table-wrapper-scroll">
                    <table style="margin: auto; width: 100%; table-layout: fixed;" cellpadding="8">
                        <thead>
                            <tr>
                                <th class="text-center text-nowrap">STT</th>
                                <th class="text-center text-nowrap">Tên thuốc</th>
                                <th class="text-center text-nowrap">Tháng 1</th>
                                <th class="text-center text-nowrap">Tháng 2</th>
                                <th class="text-center text-nowrap">Tháng 3</th>
                                <th class="text-center text-nowrap">Tháng 4</th>
                                <th class="text-center text-nowrap">Tháng 5</th>
                                <th class="text-center text-nowrap">Tháng 6</th>
                                <th class="text-center text-nowrap">Tháng 7</th>
                                <th class="text-center text-nowrap">Tháng 8</th>
                                <th class="text-center text-nowrap">Tháng 9</th>
                                <th class="text-center text-nowrap">Tháng 10</th>
                                <th class="text-center text-nowrap">Tháng 11</th>
                                <th class="text-center text-nowrap">Tháng 12</th>
                                <th class="text-center text-nowrap">Tổng cộng</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="phan_trang d-flex justify-content-end align-items-center">
                    <div class="d-flex align-items-center me-3">
                        <label class="form-label" style="font-size:1rem !important;">Số bản ghi mỗi trang:</label>
                        <select id="pageSizeSelect" style="font-size:1rem !important;" class="form-select">
                            <option value="10">10</option>
                            <option value="20" selected>20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <div style="display:flex; align-items:center; ">
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center" id="pagination">
                            </ul>
                        </nav>
                        <div class="text-center" style="margin-left: 2px">
                            <span id="pageInfo"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @section Scripts {
    <script src="@Url.Content("~/dist/js/J0304MBaoCaoSoLuongNhapXuat/J0304M_Report.js")" defer asp-append-version="true"></script>
    }
