@{
    ViewData["NonSixOs"] = true;
}
@* <link href="~/dist/lib/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css" rel="stylesheet" />
<link href="/dist/css/toastr.min.css?1684106062" rel="stylesheet" />
<link rel="stylesheet" href="@Url.Content("~/dist/css/CSS0304/C0304_Report.css")" /> *@

<style>
    body, label, input, select, button, .form-label, .form-control, .input-group-text {
        font-size: 13px !important;
        font-weight: 400;
        margin: 0;
        padding: 0;
    }

    .form-control, select, button {
        height: 36px;
        line-height: 36px;
    }

    .container_Team3 {
        display: flex;
        flex-direction: column;
        height: 74vh;
        width: 100%;
    }

        .container_Team3.top {
            flex: 0 0 10%;
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
        }

        .container_Team3.content {
            flex: 1;
            width: 100%;
            overflow: auto;
            padding: 8px;
            box-sizing: border-box;
        }
</style>

    <div class="card p-1 w-full ">
        <div class="container_Team3">
            <div class="container_Team3 top">
                <div class="row align-items-center g-3">
                    <div class="col-md-3">
                        <div class="d-flex align-items-center">
                            <label for="ngayTuNgay" class="form-label mb-0 me-2 d-inline-flex align-items-center" style="width: auto;">Từ ngày: </label>
                            <div class="input-group flex-grow-1" id="ngayTuNgay-datepicker" style="flex-shrink: 1;">
                                <input type="text"
                                       class="form-control date-input"
                                       id="ngayTuNgay"
                                       name="TuNgay"
                                       value='@DateTime.Now.ToString("dd-MM-yyyy")'
                                       placeholder="dd-mm-yyyy"
                                       autocomplete="off" />
                                    <span class="input-group-text cursor-pointer datepicker-trigger" id="ngayTuNgay-icon"
                                            style="padding: 0.375rem 0.5rem; display: flex; align-items: center; justify-content: center;">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6c757d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                    </span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="d-flex align-items-center">
                            <label for="ngayDenNgay" class="form-label mb-0 me-2 d-inline-flex align-items-center" style="width: auto;">Đến ngày: </label>
                            <div class="input-group flex-grow-1" id="ngayDenNgay-datepicker">
                                <input type="text"
                                       class="form-control date-input"
                                       id="ngayDenNgay"
                                       name="DenNgay"
                                       value='@DateTime.Now.ToString("dd-MM-yyyy")'
                                       placeholder="dd-mm-yyyy"
                                       autocomplete="off" />
                                <span class="input-group-text cursor-pointer datepicker-trigger" id="ngayDenNgay-icon"
                                      style="padding: 0.375rem 0.5rem; display: flex; align-items: center; justify-content: center;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6c757d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <button id="btnFilter" class="btn btn-outline-primary w-100">
                            <i class="bi bi-funnel"></i> Lọc danh sách
                        </button>
                    </div>

                    <div class="col-md-2">
                        <button id="btnExportPDF" class="btn btn-outline-danger w-100"
                                @((ViewBag.quyenVaiTro != null && ViewBag.quyenVaiTro.Xuat) ? "" : "disabled")>
                            <i class="bi bi-file-earmark-pdf"></i> PDF
                        </button>
                    </div>

                    <div class="col-md-2">
                        <button id="btnExportExcel" class="btn btn-outline-success w-100"
                                @((ViewBag.quyenVaiTro != null && ViewBag.quyenVaiTro.Xuat) ? "" : "disabled")>
                            <i class="bi bi-file-earmark-excel"></i> Excel
                        </button>
                    </div>
                </div>
            </div>

            <div class="container_Team3 content">
                <div class="row">
                    <div class="col-3">
                        <table class="table table-bordered table-striped table-hover align-middle text-center" style="margin:auto; width: 100%;" id="listBaoCao">
                            <thead class="table-secondary">
                                <tr>
                                    <th class="text-center text-nowrap" style="width:10%;">STT</th>
                                    <th class="text-center text-nowrap" style="width:80%;">Tên báo cáo</th>
                                    <th class="text-center text-nowrap" style="width:10%;">Chọn</th>
                                </tr>
                            </thead>
                            <tbody>

                            </tbody>
                        </table>
                    </div>
                    <div class="col-9">
                        <!-- Thêm spinner -->
                        <div id="loadingSpinner" class="text-center" style="display: none; margin: 20px 0;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p>Đang tải dữ liệu...</p>
                        </div>

                        <div class="table-wrapper-scroll" style="height: 55vh !important;">
                            <table style="margin: auto;" cellpadding="8" id="bangDuLieu">
                                <thead>

                                </thead>
                                <tbody>

                                </tbody>
                            </table>
                        </div>

                        <div style="margin: 0 auto;" class="phan_trang">
                            <div class="d-flex">
                                <label class="form-label" style="font-size:1rem !important;">Số bản ghi mỗi trang:</label>
                                <select id="pageSizeSelect" style="font-size:1rem !important;" class="form-select">
                                    <option value="10">10</option>
                                    <option value="20" selected>20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                            <div style="display:flex; align-items:center; ">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center" id="pagination">
                                    </ul>
                                </nav>
                                <div class="text-center" style="margin-left: 2px">
                                    <span id="pageInfo"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>    
@section Scripts {
    @* <script src="~/dist/lib/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js" defer></script>
    <script src="~/dist/lib/bootstrap-datepicker/js/locales/bootstrap-datepicker.vi.min.js" defer></script>
    <script src="/dist/lib/tom-select/dist/js/tom-select.base.js" defer></script>
    <script src="~/dist/lib/toastr/build/toastr.min.js" defer></script> *@
    <script src="~/dist/js/j0304util/j0302dateformatutil.js" defer></script>
    <script src="@Url.Content("~/dist/js/J0304/J0304MauChungBaoCao.js")" defer asp-append-version="true"></script>

}
