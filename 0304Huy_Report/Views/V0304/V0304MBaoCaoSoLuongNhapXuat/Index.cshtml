@{
    ViewData["NonSixOs"] = true;
}
@{
    var jsonkhoHang = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DSKhoHang);
}
<style>
    table {
        border-right: 1px solid #ccc !important;
        border-left: 1px solid #ccc !important;
    }

    .table-wrapper-scroll th,
    .table-wrapper-scroll td {
        white-space: nowrap;
    }

    .table-wrapper-scroll thead th:nth-child(1) {
        position: sticky !important;
        top: 0px;
        left: 0;
        z-index: 25;
        background-color: #f2f2f2;
        border-right: 1px solid #ccc !important;
        width: 65px;
    }

    .table-wrapper-scroll thead th:last-child {
        position: sticky !important;
        top: 0px;
        right: 0;
        z-index: 25;
        background-color: #f2f2f2;
        border-right: 1px solid #ccc !important;
        width: 80px;
    }

    .table-wrapper-scroll thead th:nth-child(2) {
        position: sticky !important;
        top: 0px;
        left: 65px;
        z-index: 25;
        background-color: #f2f2f2;
        border-right: 1px solid #ccc !important;
        width: 105px !important;
        min-width: 105px !important;
        max-width: 105px !important;
    }

    .table-wrapper-scroll thead th:nth-child(3) {
        position: sticky !important;
        top: 0px;
        left: 170px; /* bằng đúng width cột 1 */
        z-index: 25;
        background-color: #f2f2f2;
        border-right: 1px solid #ccc !important;
    }

    .table-wrapper-scroll tbody tr td:nth-child(1) {
        position: sticky;
        left: 0;
        z-index: 1;
        background-color: white;
        border-right: 1px solid #ccc !important;
        width: 65px;
    }

    .table-wrapper-scroll tbody tr td:last-child {
        position: sticky;
        right: 0;
        z-index: 1;
        background-color: white;
        border-right: 1px solid #ccc !important;
        width: 80px;
    }

    .table-wrapper-scroll tbody tr td:nth-child(2):not(.khongapdung) {
        position: sticky;
        left: 65px; /* bằng đúng width cột 1 */
        z-index: 1;
        background-color: white;
        border-right: 1px solid #ccc !important;
        width: 105px !important;
        min-width: 105px !important;
        max-width: 105px !important;
    }

    .table-wrapper-scroll tbody tr td:nth-child(3):not(.khongapdung) {
        position: sticky;
        left: 170px; /* bằng đúng width cột 1 */
        z-index: 1;
        background-color: white;
        border-right: 1px solid #ccc !important;
    }

    /* Hover cho dữ liệu thường */
    .table-wrapper-scroll tbody tr:hover td {
        background-color: #bae7ff !important;
    }

    /* Định dạng dòng tổng */
    .table-wrapper-scroll tbody tr.total-row td {
        background-color: #f0f0f0;
        font-weight: bold;
    }

    .table-wrapper-scroll tr.selected td {
        background-color: #bae7ff !important;
    }


    body, label, input, select, button, .form-label, .form-control, .input-group-text {
        font-size: 13px !important;
        font-weight: 400;
        margin: 0;
        padding: 0;
    }

    .form-control, select, button {
        height: 36px;
        line-height: 36px;
    }

    .container_Team3 {
        display: flex;
        flex-direction: column;
        height: 80vh;
        width: 100%;
    }

        .container_Team3.top {
            flex: 0 0 10%;
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
        }

        .container_Team3.content {
            flex: 1;
            width: 100%;
            overflow: auto;
            padding: 8px;
            box-sizing: border-box;
        }

    .filter-row {
        display: flex;
        gap: 4px;
        width: 100%;
    }

        .filter-row > * {
            /* flex: 1; */
            min-width: 100px;
        }

    #yearDropdown {
        outline: none;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        background-color: #fff;
        padding: 4px 8px;
        appearance: none;
        -moz-appearance: none;
        -webkit-appearance: none;
    }

        #yearDropdown option {
            border: 0;
            outline: 0;
        }

    .phan_trang {
        margin: 20px 0 !important;
    }
</style>

@section Styles {
}
    <div class="card p-1">
        <div class="container_Team3">
            <div class="container_Team3 top">
                <div class="row g-3 align-items-end">
                    <div class="col-md-1">
                        <label for="nam" class="form-label">Chọn năm</label>
                        <select class="form-select tomselect-nam" name="tenNam"></select>
                    </div>
                    <!--Nhóm hàng-->
                    <div class="col-md-2">
                        <label for="NhomHang" class="form-label">Nhóm hàng</label>
                        <select class="form-select tomselect-nhomHang" name="tenNhomHang"></select>
                    </div>

                    <div class="col-md-4">
                        <label for="HangHoa" class="form-label">Hàng hóa</label>
                        <select class="form-select tomselect-hangHoa" name="tenHangHoa"></select>
                    </div>

                    <div class="col-md-2 d-flex justify-content-center">
                        <div class="d-flex align-items-end gap-3" style="margin-top:5px;">
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="filterType" id="filterNhap" value="Nhap" checked>
                                    <label class="form-check-label" for="filterNhap">Nhập</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="filterType" id="filterXuat" value="Xuat">
                                    <label class="form-check-label" for="filterXuat">Xuất</label>
                                </div>
                            </div>
                            <button id="btnFilter" class="btn btn-outline-primary" style="margin-bottom: 0px !important; ">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button id="btnExportPDF" class="btn btn-outline-danger flex-fill"
                                @((ViewBag.quyenVaiTro != null && ViewBag.quyenVaiTro.Xuat) ? "" : "disabled")>
                            <i class="bi bi-file-earmark-pdf"></i> PDF
                        </button>
                        <button id="btnExportExcel" class="btn btn-outline-success flex-fill"
                                @((ViewBag.quyenVaiTro != null && ViewBag.quyenVaiTro.Xuat) ? "" : "disabled")>
                            <i class="bi bi-file-earmark-excel"></i> Excel
                        </button>
                    </div>
                </div>
            </div>

            <div class="container_Team3 content">
                <div id="loadingSpinner" class="text-center" style="display: none; margin: 20px 0;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Đang tải dữ liệu...</p>
                </div>

                <div class="table-wrapper-scroll">
                    <table style="margin: auto; width: 100%;" cellpadding="8">
                        <thead>
                            <tr>
                                <th class="text-center text-nowrap">STT</th>
                                <th class="text-center text-nowrap">Mã thuốc</th>
                                <th class="text-center text-nowrap">Tên thuốc</th>
                                <th class="text-center text-nowrap">Tháng 1</th>
                                <th class="text-center text-nowrap">Tháng 2</th>
                                <th class="text-center text-nowrap">Tháng 3</th>
                                <th class="text-center text-nowrap">Tháng 4</th>
                                <th class="text-center text-nowrap">Tháng 5</th>
                                <th class="text-center text-nowrap">Tháng 6</th>
                                <th class="text-center text-nowrap">Tháng 7</th>
                                <th class="text-center text-nowrap">Tháng 8</th>
                                <th class="text-center text-nowrap">Tháng 9</th>
                                <th class="text-center text-nowrap">Tháng 10</th>
                                <th class="text-center text-nowrap">Tháng 11</th>
                                <th class="text-center text-nowrap">Tháng 12</th>
                                <th class="text-center text-nowrap">Tổng cộng</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="phan_trang d-flex justify-content-end align-items-center">
                    <div class="d-flex align-items-center me-3">
                        <label class="form-label" style="font-size:1rem !important;">Số bản ghi mỗi trang:</label>
                        <select id="pageSizeSelect" style="font-size:1rem !important;" class="form-select">
                            <option value="10">10</option>
                            <option value="20" selected>20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <div style="display:flex; align-items:center; ">
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center" id="pagination">
                            </ul>
                        </nav>
                        <div class="text-center" style="margin-left: 2px">
                            <span id="pageInfo"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @section Scripts {
    <script src="@Url.Content("~/dist/js/J0304/J0304BaoCaoSoLuongNhapXuat.js")" defer asp-append-version="true"></script>
    }
