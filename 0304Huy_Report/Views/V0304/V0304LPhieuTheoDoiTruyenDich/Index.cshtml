@{
    ViewData["NonSixOs"] = true;
}
@{
    var jsonBenhNhan = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DSBenhNhan);
}

<style>
    table {
        border-right: 1px solid #ccc !important;
        border-left: 1px solid #ccc !important;
    }
    .table-wrapper-scroll th,
    .table-wrapper-scroll td {
        white-space: nowrap; /* giữ nội dung không xuống dòng */
    }

    /* Header - Cố định 2 cột */
    .table-wrapper-scroll thead th:nth-child(1) {
        position: sticky;
        top: 0;
        left: 0;
        z-index: 22;
        background-color: #f2f2f2;
        border-right: 1px solid #ccc !important;
        min-width: 65px;
    }

    .table-wrapper-scroll thead th:nth-child(2) {
        position: sticky;
        top: 0;
        left: 65px; /* bằng đúng width cột 1 */
        z-index: 22;
        background-color: #f2f2f2;
        border-right: 1px solid #ccc !important;
        min-width: 100px;
    }

    .table-wrapper-scroll thead th:nth-child(3) {
        position: sticky;
        top: 0;
        left: 165px; /* bằng đúng width cột 1 */
        z-index: 22;
        background-color: #f2f2f2;
        border-right: 1px solid #ccc !important;
    }
    /* Body - Cố định 2 cột (trừ dòng tổng) */
    .table-wrapper-scroll tbody tr td:nth-child(1) {
        position: sticky;
        left: 0;
        z-index: 20;
        background-color: white;
        border-right: 1px solid #ccc !important;
        min-width: 65px;
    }

    .table-wrapper-scroll tbody tr td:nth-child(2):not(.khongapdung) {
        position: sticky;
        left: 65px; /* bằng đúng width cột 1 */
        z-index: 20;
        background-color: white;
        border-right: 1px solid #ccc !important;
        min-width: 100px;
    }

    .table-wrapper-scroll tbody tr td:nth-child(3):not(.khongapdung) {
        position: sticky;
        left: 165px; /* bằng đúng width cột 1 */
        z-index: 20;
        background-color: white;
        border-right: 1px solid #ccc !important;
    }

    /* Hover cho dữ liệu thường */
    .table-wrapper-scroll tbody tr:hover td {
        background-color: #bae7ff !important;
    }

    /* Định dạng dòng tổng */
    .table-wrapper-scroll tbody tr.total-row td {
        background-color: #f0f0f0;
        font-weight: bold;
    }

    .table-wrapper-scroll tr.selected td {
        background-color: #bae7ff !important;
    }
</style>

    <div class="card p-1">
        <div class="container_Team3">
            <div class="container_Team3 left">
                <div class="row" style="padding:0; margin: 5px;">
                    <div style="width: 100%;padding:0;margin:0px;" class="mb-1 input-wrapper">
                        <label for="KhoTra" class="form-label">Bệnh nhân</label>
                    <input type="text" class="form-control" id="comboBox" name="tenBenhNhan" data-value="@ViewBag.benhNhan">
                    <input type="hidden" id="IDBenhNhan" name="IDBenhNhan" data-value="@ViewBag.IDBenhNhan" />
                        <div class="dropdownList" id="dropdownList"></div>
                    </div>

                    <label style="padding:0; margin:0px;">
                        <button id="btnFilter" class="btn btn-outline-primary mb-3">
                            <i class="bi bi-funnel"></i> Lọc danh sách
                        </button>
                    </label>

                </div>
                <div style="padding:0; margin: 5px;" class="row export-buttons">
                    <button id="btnExportPDF" class="btn btn-outline-danger mb-3" @((ViewBag.quyenVaiTro != null && ViewBag.quyenVaiTro.Xuat) ? "" : "disabled")>
                        <i class="bi bi-file-earmark-pdf"></i> Xuất PDF
                    </button>
                </div>
            </div>

            <div class="container_Team3 right">
                <!-- Thêm spinner -->
                <div id="loadingSpinner" class="text-center" style="display: none; margin: 20px 0;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Đang tải dữ liệu...</p>
                </div>

                <div class="table-wrapper-scroll">
                    <table style="margin: auto; table-layout: fixed;" cellpadding="8">
                        <thead>
                            <tr>
                                <th class="text-center text-nowrap">STT</th>
                                <th class="text-center text-nowrap">Ngày tháng</th>
                                <th class="text-center text-nowrap">Tên dịch truyền, Hàm lượng</th>
                                <th class="text-center text-nowrap">Số lượng</th>
                                <th class="text-center text-nowrap"> Lô, Số sản xuất</th>
                                <th class="text-center text-nowrap">Tốc độ giọt/ph</th>
                                <th class="text-center text-nowrap">TG bắt đầu</th>
                                <th class="text-center text-nowrap">TG kết thúc</th>
                                <th class="text-center text-nowrap">BS chỉ định</th>
                                <th class="text-center text-nowrap">YT (ĐD) thực hiện</th>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="phan_trang">
                    <div class="d-flex">
                        <label class="form-label" style="font-size:1rem !important;">Số bản ghi mỗi trang:</label>
                        <select id="pageSizeSelect" style="font-size:1rem !important;" class="form-select">
                            <option value="10">10</option>
                            <option value="20" selected>20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <div style="display:flex; align-items:center; ">
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center" id="pagination">
                            </ul>
                        </nav>
                        <div class="text-center" style="margin-left: 2px">
                            <span id="pageInfo"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
    let provincesDataBenhNhan = @Html.Raw(ViewBag.DSBenhNhan ?? "[]");

        if (typeof provincesDataBenhNhan === "string") {
            provincesDataBenhNhan = JSON.parse(provincesDataBenhNhan);
        }
    </script>
    @section Scripts {
    <script src="@Url.Content("~/dist/js/J0304/J0304PhieuTheoDoiTruyenDich.js")" defer asp-append-version="true"></script>
    }
